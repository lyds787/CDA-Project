/* Sign Extend */
void sign_extend(unsigned offset,unsigned *extended_value)
{
    *extended_value = (offset & 0x00008000) ? (offset | 0xffff0000) : offset;
}


/* ALU operations */
int ALU_operations(unsigned data1, unsigned data2, unsigned extended_value, unsigned funct, char ALUOp, char ALUSrc, unsigned *ALUresult, char *Zero) {
    // Determine the operand B based on ALUSrc
    unsigned operand_B = (ALUSrc == 1) ? extended_value : data2;

    // Check if R-type instruction (ALUOp 7)
    if (ALUOp == 7) {
        // Determine the specific ALU operation based on the function code (funct) for R-type instructions
        switch (funct) {
            case 32: // Add
                ALUOp = 0;
                break;
            case 34: // Subtract
                ALUOp = 1;
                break;
            case 42: // Set Less Than (signed)
                ALUOp = 2;
                break;
            case 43: // Set Less Than (unsigned)
                ALUOp = 3;
                break;
            case 36: // AND
                ALUOp = 4;
                break;
            case 37: // OR
                ALUOp = 5;
                break;
            case 6:  // Shift Left Extended Value by 16
                ALUOp = 6;
                break;
            case 39: // NOR
                ALUOp = 7;
                break;
            default:
                return 1; // Halt for unsupported function code
        }

        // Call ALU function for R-type instruction
        ALU(data1, operand_B, ALUOp, ALUresult, Zero);
    } else {
        // Call ALU function for non-R-type instruction
        ALU(data1, operand_B, ALUOp, ALUresult, Zero);
    }

    return 0; // Return success
}



/* Read / Write Memory */
int rw_memory(unsigned ALUresult, unsigned data2, char MemWrite, char MemRead, unsigned *memdata, unsigned *Mem) {
    // Check if MemRead is enabled
    if (MemRead) {
        // Check if the address is properly aligned
        if (ALUresult % 4 == 0) {
            // Read from memory and store the result in memdata
            *memdata = Mem[ALUresult >> 2];
        } else {
            // Improper Address, return 1 for Halt
            return 1;
        }
    }

    // Check if MemWrite is enabled
    if (MemWrite) {
        // Check if the address is properly aligned
        if (ALUresult % 4 == 0) {
            // Write data2 to memory
            Mem[ALUresult >> 2] = data2;
        } else {
            // Improper Address, return 1 for Halt
            return 1;
        }
    }

    // Successful execution, return 0
    return 0;
}

/* Write Register */
void write_register(unsigned r2, unsigned r3, unsigned memdata, unsigned ALUresult, char RegWrite, char RegDst, char MemtoReg, unsigned *Reg) {
    // Check if writing to registers is enabled
    if (RegWrite) {
        // Determine the destination register based on MemtoReg and RegDst
        unsigned destination_register = (MemtoReg == 1) ? r3 : r2;

        // Write data to the appropriate register
        Reg[destination_register] = (MemtoReg == 1) ? memdata : ALUresult;
    }
    // No action if RegWrite is not enabled
}

/* PC update */
void PC_update(unsigned jsec, unsigned extended_value, char Branch, char Jump, char Zero, unsigned *PC) {
    // Always increment the PC by 4
    *PC += 4;

    // Update the PC based on the conditions
    if (Branch && Zero) {
        // If branching and Zero is true, add the extended value shifted left by 2 bits
        *PC += extended_value << 2;
    }

    if (Jump) {
        // If Jump is true, set the PC to the jump target shifted left by 2 bits
        // ORed with the upper four bits of the original PC
        *PC = (jsec << 2) | (*PC & 0xF0000000);
    }
}
