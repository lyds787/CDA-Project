/* ALU */
/* 10 Points */
void ALU(unsigned A,unsigned B,char ALUControl,unsigned *ALUresult,char *Zero)
{
    //use switch case for to determine ALUresult based on ALUControl (Which operation is being executed)
    switch ((int)ALUControl) {
        case 0:                      //ALUControl = 000
                *ALUresult = A + B;  //addition
                break;
        case 1:                      //ALUControl = 001
                *ALUresult = A - B;  //subtraction
                break;
        case 2:                     //ALUControl = 010
                if ((signed) A < (signed) B){// is A less than B, for signed values
                    *ALUresult = 1;     //assert as 1 if true
                } else {
                    *ALUresult = 0;     //0 if false
                } break;
        case 3:                    //ALUControl = 011
                if ((unsigned) A < (unsigned) B){        // is A less than B, for unsigned values
                    *ALUresult = 1;     //1 if true
                } else {
                    *ALUresult = 0;     //0 if false
                } break;
        case 4:                    //ALUControl = 100
            *ALUresult = A & B;    //A AND B
                break;
        case 5:                    //ALUControl = 101
            *ALUresult = A | B;    //A XOR B
                break;
        case 6:                    //ALUControl = 110
        *ALUresult = (B << 16); //  SHIFT B left by 16 bits
                break;
        case 7:                    //ALUControl = 111
                *ALUresult = ~A;   // NOT A
                break;
        }
    if (*ALUresult == 0) {    // if *ALUresult is 0, set *Zero to 1
        *Zero = 1;
    } else {                  // if *ALUresult is 1, set *Zero to 0
        *Zero = 0;
    }
}
            
   
/* instruction fetch */
/* 10 Points */
//////////////////////////////////////////////////////////////////////
int instruction_fetch(unsigned PC,unsigned *Mem,unsigned *instruction)
{
    unsigned PCShift = PC >> 2;
                                    // Check for word alignment
    if (PC % 4 == 0) {              //if divisible by 4 it is in the correct word alignment
        *instruction = Mem[PCShift];
        return 0;                   
    } else {                        // else it is misalignment, return 1 for halt condition

        return 1;                   // Halt condition, return 1
    }


}


/* instruction partition */
/* 10 Points 
- Partition instruction into several parts (op, r1, r2, r3, funct, offset, jsec).
- Read lines 41 to 47 of spimcore.c for more information

/*** DATAPATH Signals ***/
// names of instruction sections


/*
unsigned instruction;
unsigned op, // instruction [31-26]
    r1, // instruction [25-21]
    r2, // instruction [20-16]
    r3, // instruction [15-11]
    funct, // instruction [5-0]
    offset, // instruction [15-0]
    jsec; // instruction [25-0]
    */
/////////////////////////////////////////////////////////////////////

void instruction_partition(unsigned instruction, unsigned *op, unsigned *r1,unsigned *r2, unsigned *r3, unsigned *funct, unsigned *offset, unsigned *jsec)
{
    *op = (instruction >> 26);    
    
    *r1 = (instruction >> 21) & 0b11111;    //5 bits
    
    *r2 = (instruction >> 16) & 0b11111;    //5 bits
    
    *r3 = (instruction >> 11) & 0b11111;    //5 bits
    
    *funct = instruction & (0b111111);      //6 bits
    
    *offset = instruction & (0b1111111111111111);   //16 bits
    
    *jsec = instruction & (0b11111111111111111111111111);   //26 bits

}




