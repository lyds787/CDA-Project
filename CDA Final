/* ALU */
/* 10 Points */
void ALU(unsigned A,unsigned B,char ALUControl,unsigned *ALUresult,char *Zero)
{
switch (ALUControl) {
    case 0:
            *ALUresult = A + B;  //addition
            break;
    case 1:
            *ALUresult = A - B;  //subtraction
            break;
    case 2:
            int A = A;          // less than int
            int B = B;
            if (A < B)
                *ALUresult = 1;
            else
                *ALUresult = 0;
            break;
    case 3:
            if (A < B)        // less than unsigned
                *ALUresult = 1;
            else
                *ALUresult = 0;
            break;
    case 4:
        *ALUresult = A & B;    //AND
            break;
    case 5:
        *ALUresult = A | B;    //XOR
            break;
    case 6:
       *ALUresult = (B << 16);      //  SHIFT Not confident!
            break;
        case 7:                //NOT
            *ALUresult = ~A;
            break;
    }
    if (*ALUresult == 0) {    // if *ALUresult is 0, set *Zero to 1
        *Zero = 1;
    } else {                  // if *ALUresult is 1, set *Zero to 0
        *Zero = 0;
    }
}
            
   
/* instruction fetch */
/* 10 Points */
int instruction_fetch(unsigned PC,unsigned *Mem,unsigned *instruction)
{
                                    // Check for word alignment
    if (PC & 0x3) {
        return 1;                 // Misalignment, return 1 for halt condition
    }

                                // Check for halt condition
    if (PC > 65535) {
        return 1;                 // Halt condition, return 1
    }

    *instruction = Mem[PC >> 2};

    return 0;
}

